{
  "host": "0.0.0.0",
  "monitor_port": 8082,
  "llm_url": "http://localhost:8080",
  "llm_api_type": "openai",
  "max_queue": 10,
  "max_parallel_jobs": 1,
  "accept_new_jobs": true,
  "maintenance": false,
  "gpu": {
    "type": "auto",
    "nvidia_smi_path": "nvidia-smi",
    "rocm_smi_path": "rocm-smi"
  },
  "monitoring": {
    "update_interval": 1.0,
    "history_size": 1000
  },
  "performance": {
    "prefill_tok_s": 420,
    "decode_tok_s": 61,
    "model_memory_mb": 5120
  },
  "models": {
    "default": "llama3.1:8b",
    "available": ["llama3.1:8b", "qwen2:7b", "deepseek-coder:6.7b"],
    "max_context": 8192,
    "load_time": 15
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}
